add_rules("mode.debug", "mode.release")
set_languages("c++20")

target("gameak-core")
    set_kind("static")
    add_includedirs("Include", {public = true})
    add_includedirs("Libs", "Libs/cest")
    add_files("Src/GameAk/Core/*.cpp")
    add_cxxflags("-Wno-interference-size", {public = true})

target("gameak-runtime")
    set_kind("static")
    add_includedirs("Include", {public = true})
    add_includedirs("Libs", "Libs/cest")
    add_files("Src/GameAk/Runtime/*.cpp")
    add_deps("gameak-core")
    add_cxxflags("-Wno-interference-size", {public = true})
