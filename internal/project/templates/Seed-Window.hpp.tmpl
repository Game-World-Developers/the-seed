#pragma once

#include <GameAk/Core/result.h>
#include <SDL3/SDL.h>

namespace seed {

constexpr int kDefaultWidth = 800;
constexpr int kDefaultHeight = 600;

// ── RAII wrapper for SDL_Window ────────────────────────────────────

class Window {
public:
    static gameak::core::Result<Window> create(
        const char* title,
        int width,
        int height,
        SDL_WindowFlags flags = 0
    ) {
        auto* win = SDL_CreateWindow(title, width, height, flags);
        if (!win) {
            return gameak::core::Error(
                gameak::core::ErrorCode::InternalError,
                SDL_GetError()
            );
        }
        return Window(win);
    }

    ~Window() {
        if (window_) SDL_DestroyWindow(window_);
    }

    Window(const Window&) = delete;
    Window& operator=(const Window&) = delete;

    Window(Window&& other) noexcept
        : window_(other.window_)
    {
        other.window_ = nullptr;
    }

    Window& operator=(Window&& other) noexcept {
        if (this != &other) {
            if (window_) SDL_DestroyWindow(window_);
            window_ = other.window_;
            other.window_ = nullptr;
        }
        return *this;
    }

    [[nodiscard]] SDL_Window* get() const { return window_; }

private:
    explicit Window(SDL_Window* win)
        : window_(win)
    {}

    SDL_Window* window_{nullptr};
};

} // namespace seed
