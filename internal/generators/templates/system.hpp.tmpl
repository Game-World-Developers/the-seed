    }
    return rt.register_controller({{.Namespace}}::{{.Name}}{}, {{.Priority}}, type_access);
    {{- else -}}
    return rt.register_controller({{.Namespace}}::{{.Name}}{}, {{.Priority}});
    {{- end}}
}