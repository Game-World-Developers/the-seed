inline gameak::core::Result<void> register_{{.Name}}(gameak::runtime::Runtime<>& rt) {
    {{if .Access -}}
    gameak::core::flat_vector<uint32_t, 4> type_access;
    for (const auto& [tid, desc] : rt.block_types()) {
        {{- range .Access}}
        if (desc.name == "{{.Name}}") { type_access.push_back(tid); continue; }
